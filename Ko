-- STREAMING_CHUNK:Checking player authorization function...
local function IsAdmin(player)
if not player then return false end
-- ตรวจสอบว่าเป็นเจ้าของแมพหรือไม่
if CONFIG.AutoAdminCreator and game.CreatorId > 0 then
if player.UserId == game.CreatorId then
return true
end
end
-- ตรวจสอบ UserId
for _, id in ipairs(CONFIG.AdminUserIds) do
if player.UserId == id then
return true
end
end
-- ตรวจสอบ Username
for _, name in ipairs(CONFIG.AdminUsernames) do
if string.lower(player.Name) == string.lower(name) then
return true
end
end
return false
end
-- STREAMING_CHUNK:Target player finder utility...
local function FindPlayers(sender, targetName)
if not targetName or targetName == "" then return {sender} end
targetName = string.lower(targetName)
if targetName == "me" then
return {sender}
elseif targetName == "all" then
return Players:GetPlayers()
elseif targetName == "others" then
local found = {}
for _, p in ipairs(Players:GetPlayers()) do
if p ~= sender then table.insert(found, p) end
end
return found
elseif targetName == "random" then
local all = Players:GetPlayers()
return {all[math.random(1, #all)]}
end
local matched = {}
for _, p in ipairs(Players:GetPlayers()) do
if string.find(string.lower(p.Name), targetName) or string.find(string.lower(p.DisplayName), targetName) then
table.insert(matched, p)
end
end
return matched
end
-- STREAMING_CHUNK:Registering Admin Commands...
local function RegisterCommand(names, description, usage, callback)
table.insert(CommandList, {
Names = names,
Description = description,
Usage = usage,
Callback = callback
})
end
-- STREAMING_CHUNK:Defining core admin actions...
-- 1. Speed Command (;speed me 50)
RegisterCommand({"speed", "ws"}, "ปรับความเร็วการเดิน", ";speed [player] [number]", function(sender, args)
local targets = FindPlayers(sender, args[1])
local speedVal = tonumber(args[2]) or 16
for _, target in ipairs(targets) do
if target.Character and target.Character:FindFirstChildOfClass("Humanoid") then
target.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = speedVal
end
end
end)
-- 2. JumpPower Command (;jump me 100)
