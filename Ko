-- ใส่ Username ของผู้เล่นที่ต้องการให้เป็นแอดมินที่นี่
AdminUsernames = {
"YourUsernameHere", -- เปลี่ยนเป็นชื่อ Roblox ของคุณ
},
-- หรือใส่ UserId ของผู้เล่น
