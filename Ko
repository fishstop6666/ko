-- STREAMING_CHUNK:Parsing and executing commands...
local function ExecuteCommand(sender, text)
if not IsAdmin(sender) then return end
if string.sub(text, 1, #CONFIG.Prefix) ~= CONFIG.Prefix then return end
local cleanText = string.sub(text, #CONFIG.Prefix + 1)
local splitText = string.split(cleanText, " ")
local cmdName = string.lower(splitText[1])
local args = {}
for i = 2, #splitText do
table.insert(args, splitText[i])
end
for _, cmd in ipairs(CommandList) do
for _, alias in ipairs(cmd.Names) do
if alias == cmdName then
local success, err = pcall(function()
cmd.Callback(sender, args)
end)
if not success then
warn("[Admin Nanoi Error]: " .. tostring(err))
end
return
end
end
end
end
